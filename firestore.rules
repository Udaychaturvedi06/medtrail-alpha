rules_version = '2';

/**
 * MedTrail Clinical Data Governance & Security Rules
 * Architecture: Role-Based Access Control (RBAC) with DPDP/ABDM Audit Compliance
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Core Authentication & Utility Helpers
    // ==========================================
    
    // Check if the request is originating from an authenticated session
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safely verify if the caller is a certified medical practitioner (Doctor)
    // Uses crash-proof exists() and get() guards
    function isDoctor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'doctor';
    }

    // Safely verify if the caller is the patient's authorized Caregiver
    // Checks both emergencyContactEmail and caregiverEmail mappings against verified auth token
    function isAssignedCaregiver(patientId) {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/users/$(patientId)) &&
        (
          get(/databases/$(database)/documents/users/$(patientId)).data.get('emergencyContactEmail', '') == request.auth.token.email ||
          get(/databases/$(database)/documents/users/$(patientId)).data.get('caregiverEmail', '') == request.auth.token.email
        );
    }

    // ==========================================
    // Collection 1: Users (Profiles & Directory)
    // ==========================================
    match /users/{userId} {
      // Authenticated users can query directory (Required for Doctor Search & Caregiver sync)
      allow read: if isAuthenticated();

      // Users can only create or update their own personal profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      
      // Hard deletion is prohibited for medical record retention & compliance
      allow delete: if false;

      // ==========================================
      // Subcollection: Patient Medical Records
      // ==========================================
      match /records/{recordId} {
        // Clinical Privacy Guard:
        // Medical records are strictly accessible ONLY to:
        // 1. The patient themselves
        // 2. A verified Doctor during active consultation
        // 3. The patient's verified Caregiver
        allow read: if isOwner(userId) || isDoctor() || isAssignedCaregiver(userId);

        // Record Integrity:
        // ONLY the patient can upload, modify, or archive their prescriptions
        allow write, delete: if isOwner(userId);
      }
    }

    // ==========================================
    // Collection 2: Notifications & Reminders
    // ==========================================
    match /notifications/{notificationId} {
      // Allows creating reminder alerts and dispatching SOS updates
      allow create: if isAuthenticated();
      
      // Users can only view notifications dispatched to them
      allow read, update, delete: if isAuthenticated() && (
        resource.data.get('recipientEmail', '') == request.auth.token.email ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource == null
      );
    }

    // ==========================================
    // Collection 3: Audit Logs (DPDP Act 2023 Compliance)
    // ==========================================
    match /audit_logs/{logId} {
      // The system creates an immutable access log whenever a doctor views a patient chart
      allow create: if isAuthenticated();
      
      // Doctors can review access logs, and patients can view access history of their own chart
      allow read: if isAuthenticated() && (
        isDoctor() || 
        resource.data.get('patientUid', '') == request.auth.uid
      );
      
      // Strict Tamper-Proof Rule: Audit logs can NEVER be updated or deleted by anyone
      allow update, delete: if false;
    }
  }
}
